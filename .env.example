# ITG Telegram bot
# Payroll invoices: ATN | Client: Xfinity / Comcast

# --- Telegram (обязательно) ---
TELEGRAM_BOT_TOKEN=
# Ваш Telegram user id (узнать: @userinfobot). Только вы сможете пользоваться ботом.
