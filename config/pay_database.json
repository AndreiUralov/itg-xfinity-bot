  "work_areas": ["Broward", "Miami"],

  "screenshot_extraction": {
    "fields": [
      {
        "key": "job_number",
        "pattern": "Job#\\s*(\\d+)",
        "required": true,
        "merge_across_photos": true
      },
      {
        "key": "customer_name",
        "required": false
      },
      {
        "key": "address",
        "required": true
      },
      {
        "key": "account_number",
        "pattern": "849575\\d+",
        "required": false
      },
      {
        "key": "work_type",
        "values": ["Trouble Call", "Service Change", "New Install", "Special Request", "Self Install"],
        "required": true
      },
      {
        "key": "subtype_codes",
        "description": "Lines below work type: HSD OUT, TECH RECOVERY, VID UP, HSD NC, etc.",
        "required": true
      },
      {
        "key": "hookup_type",
        "values": ["Aerial", "Underground"],
        "required": false,
        "billing_note": "Not confirmed as separate payroll line in current data"
      },
      {
        "key": "dwelling_type",
        "values": ["Single Dwelling Unit", "Multiple Dwelling Unit"],
        "required": false,
        "billing_note": "MDU extra billing not confirmed — open question 6"
      }
    ],
    "photo_merge_key": "job_number",
    "photo_wait_seconds": 60
  },

  "calculation_rules": [
    {
      "id": "trouble_call",
      "priority": 10,
      "match": {
        "work_type": "Trouble Call"
      },
      "match_any_subtype": [
        "HSD OUT",
        "H2:INT OUT",
        "VIDEO TC",
        "RPT TC",
        "INT OUT"
      ],
      "lines": [{ "code": "R.T.8.", "qty": 1 }],
      "user_prompt": null,
      "confirmed": true,
      "example_jobs": [509413, 506037, 502640, 508836]
    },
    {
      "id": "service_change_tech_recovery",
      "priority": 20,
      "match": {
        "work_type": "Service Change"
      },
      "match_all_subtype": ["TECH RECOVERY"],
      "lines": [{ "code": "R.Q.2.", "qty": 1 }],
      "site_work_addon_prompt": true,
      "user_prompt": null,
      "confirmed": true,
      "example_jobs": [497745, 510236]
    },
    {
      "id": "service_change_hsd_up",
      "priority": 21,
      "match": {
        "work_type": "Service Change"
      },
      "match_any_subtype": ["HSD UP"],
      "base_lines": [{ "code": "R.A.1.", "qty": 1 }],
      "equipment_prompt": true,
      "site_work_addon_prompt": true,
      "confirmed": true
    },
    {
      "id": "service_change_vid_up",
      "priority": 22,
      "match": {
        "work_type": "Service Change"
      },
      "match_any_subtype": ["VID UP"],
      "base_lines": [{ "code": "R.A.1.", "qty": 1 }],
      "equipment_prompt": true,
      "site_work_addon_prompt": true,
      "confirmed": true,
      "example_jobs": [498945]
    },
    {
      "id": "special_request_genesis",
      "priority": 30,
      "match": {
        "work_type": "Special Request"
      },
      "match_any_subtype": ["GENESIS", "G9:GENESIS", "SRO-CF"],
      "lines": [{ "code": "R.T.17.", "qty": 1 }],
      "user_prompt": null,
      "confirmed": true,
      "example_jobs": [492449]
    },
    {
      "id": "special_request_proactive",
      "priority": 31,
      "match": {
        "work_type": "Special Request"
      },
      "match_any_subtype": ["PROACTIVE", "XIT-CF", "MONITOR FAIL", "XA:MONITOR"],
      "lines": [{ "code": "R.T.7.", "qty": 1 }],
      "user_prompt": null,
      "confirmed": true,
      "example_jobs": [475937]
    },
    {
      "id": "new_install",
      "priority": 40,
      "match": {
        "work_type": "New Install"
      },
      "subtype_hints": ["HSD NC", "HSD RC", "NC", "RC"],
      "product_prompt": {
        "options": [
          { "code": "R.N.1.", "label": "1 Product — HSD (R.N.1.)", "default": true },
          { "code": "R.J.1.", "label": "2 Product — HSD/VID (R.J.1.)" },
          { "code": "R.F.1.", "label": "3 Product — CDV/HSD/VID (R.F.1.) ?" }
        ]
      },
      "equipment_prompt": true,
      "site_work_addon_prompt": true,
      "confirmed": true,
      "example_jobs": [492264, 511180, 467347]
    },
    {
      "id": "self_install",
      "priority": 50,
      "match": {
        "work_type": "Self Install"
      },
      "lines": [{ "code": "R.Q.4.", "qty": 1 }],
      "user_prompt": null,
      "confirmed": true,
      "note": "Self Install — R.Q.4. per field guide and payroll"
    }
